# Backend
FACTORY_ENVIRONMENT=development
FACTORY_DATABASE_PATH=.data/factory.db
FACTORY_WORKSPACE_PATH=.factory/runs
FACTORY_CORS_ORIGINS=http://localhost:5173

# Optional: any OpenAI-compatible Chat Completions endpoint.
# Without these values, the safe local builder remains fully functional.
FACTORY_LLM_API_KEY=
FACTORY_LLM_BASE_URL=https://api.openai.com/v1
FACTORY_LLM_MODEL=gpt-4o-mini
